# ─── OctraChat Environment Variables ───────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it's in .gitignore.

# Octra network to use ("devnet" | "mainnet" | "custom")
OCTRA_NETWORK=devnet

# Custom RPC URL (only needed if OCTRA_NETWORK=custom)
# OCTRA_RPC_URL=http://127.0.0.1:8080/rpc

# Circle relayer URL (optional — for batched on-chain submissions)
# OCTRA_CIRCLE_RELAYER_URL=http://127.0.0.1:9494

# ─── For testing only ──────────────────────────────────
# Test wallet mnemonic (DO NOT use in production)
# OCTRA_TEST_MNEMONIC="your 24-word test mnemonic here"

# Test wallet private key (base64, 32 bytes)
# OCTRA_TEST_PRIVKEY="your test private key base64 here"

# Funded devnet address for RPC lookups
# OCTRA_TEST_FUNDED_ADDR="oct..."

# GitHub token for CI/CD sync (NEVER commit this)
# GH_TOKEN=ghp_xxx
